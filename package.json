{
  "name": "prueba_back",
  "version": "1.0.0",
  "description": "Backend de Planilla  Rubik , manejo de usuarios, roles, permisos, empleados,proyectos, reportes y mas.",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon index.js",
    "start": "node index.js",
    "start:prod": "NODE_ENV=production node index.js",
    "seed:demo": "node scripts/seedDemoData.js",
    "build": "npm run lint && npm run build-docs",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build-docs": "redocly bundle docs/openapi.json -o docs/swagger.json"
  },
  "author": "Mindfactory",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.842.0",
    "@aws-sdk/s3-request-presigner": "^3.842.0",
    "axios": "^1.10.0",
    "basic-auth": "^2.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "es-object-atoms": "^1.1.1",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "i18next": "^25.3.1",
    "i18next-http-middleware": "^3.7.4",
    "js-yaml": "^4.1.0",
    "jwt-simple": "^0.5.6",
    "moment": "^2.30.1",
    "mongoose": "^8.8.0",
    "mongoose-pagination": "^1.0.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.9",
    "nodemon": "^3.1.10",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.12.0",
    "winston": "^3.17.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@redocly/cli": "^1.34.5",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.0.3",
    "mongodb-memory-server": "^10.1.4",
    "supertest": "^7.1.1"
  },
  "overrides": {
    "mobx-react-lite": "4.1.0"
  }
}
