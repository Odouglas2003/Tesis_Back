{
  "openapi": "3.0.3",
  "info": {
    "title": "Planilla Rubik API (Versión Actualizada)",
    "version": "v2.0.0",
    "description": "Documentación actualizada de la API para el sistema Planilla Rubik. Gestiona proyectos, colaboradores, tecnologías, y más.",
    "contact": {
      "name": "Equipo de Desarrollo Planilla Rubik"
    },
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3900/api",
      "description": "Servidor de Desarrollo Local"
    }
  ],
  "tags": [
    { "name": "Users", "description": "Endpoints para la autenticación y gestión de usuarios (user.js)." },
    { "name": "Collaborators", "description": "Gestión de colaboradores (collaborator.js)." },
    { "name": "Projects", "description": "Gestión de proyectos (projects.js)." },
    { "name": "Vacancies", "description": "Gestión de vacantes (vacancie.js)." },
    { "name": "Technologies", "description": "Gestión de tecnologías (technologies.js)." },
    { "name": "Notifications", "description": "Gestión de notificaciones (notification.js)." },
    { "name": "Configuration", "description": "Endpoints de configuración del sistema (configuration.js)." },
    { "name": "Roles", "description": "Gestión de roles de usuario (rolesRoutes.js)." },
    { "name": "StateProjects", "description": "Gestión de los estados de los proyectos (stateprojects.js)." },
    { "name": "BasicFields", "description": "Gestión de definiciones de campos básicos (basicFieldRoutes.js)." },
    { "name": "ExtraFields", "description": "Gestión de campos extra personalizables (extraFieldRoutes.js)." },
    { "name": "Jornada", "description": "Endpoints para la gestión de jornadas (jornadaRoutes.js)." },
    { "name": "IA", "description": "Endpoints relacionados con IA (iaRoutes.js)." },
    { "name": "Upload", "description": "Endpoints para la subida de archivos (upload.routes.js)." },
    { "name": "Dashboard", "description": "Endpoints para obtener métricas y datos consolidados." },
    { "name": "IA - Metrics", "description": "Endpoints para que servicios de IA consuman datos del sistema." },
    { "name": "Skills", "description": "Gestión de habilidades y tecnologías." }
  ],
